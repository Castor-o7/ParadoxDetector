# Copy to .env and fill in whichever keys you have. Every key is optional;
# beacons without a required key are skipped and the paradox score uses the rest.

# Fast tier
OTX_API_KEY=            # optional, raises AlienVault OTX rate limits (free at otx.alienvault.com)
GREYNOISE_API_KEY=      # optional, community key (free at greynoise.io)
ABUSEIPDB_API_KEY=      # required for AbuseIPDB (free tier at abuseipdb.com)
THREATFOX_API_KEY=      # required for ThreatFox (free abuse.ch Auth-Key at auth.abuse.ch)

# Slow tier
VIRUSTOTAL_API_KEY=     # required for VirusTotal (free public API key)
# PARADOX_VT_MAX_WAIT=60   # longest a lookup waits for a free-tier slot, in seconds; 0 = never wait

# Optional Claude analyst summary (pip install anthropic)
ANTHROPIC_API_KEY=
# PARADOX_CLAUDE_MODEL=claude-opus-5-5

# MCP server
# PARADOX_LOG_DIRS=/var/log   # folders scan_log's path may read, separated by : (; on Windows)

# Web server
# PARADOX_HOST=127.0.0.1    # 0.0.0.0 to listen on all interfaces (requires PARADOX_PASSWORD)
# PARADOX_PORT=8787
PARADOX_PASSWORD=           # HTTP Basic auth password (any username); required when exposed
# PARADOX_RATE_LIMIT=20     # scans + summaries per client per minute, 0 = off
# PARADOX_TRUST_PROXY=1     # behind a reverse proxy: rate-limit by X-Forwarded-For
# PARADOX_ALLOW_OPEN=1      # allow a non-loopback bind without a password (proxy does auth)
